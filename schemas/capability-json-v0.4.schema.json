{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/primeiraacademiadev/Arcanum/blob/main/schemas/capability-json-v0.4.schema.json",
  "title": "Arcanum Capability JSON v0.4 (next-prototype executable subset)",
  "type": "object",
  "description": "Draft 0.4 executable core; future handlers, explicit response directives and operations are out of scope.",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "displayName",
    "models",
    "templates",
    "contract",
    "graph"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/template"
      }
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "graph": {
      "$ref": "#/$defs/graph"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "foreignKey": {
          "type": "string"
        },
        "externalKey": {
          "type": "object",
          "required": [
            "key",
            "targetSystem"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "targetSystem": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "template": {
      "type": "object",
      "required": [
        "process",
        "inputs",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "process": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "pattern": "^\\$(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "default": {}
      },
      "not": {
        "required": [
          "source",
          "default"
        ]
      }
    },
    "response": {
      "type": "object",
      "required": [
        "name",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "inputs",
        "response"
      ],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        },
        "response": {
          "$ref": "#/$defs/response"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "template",
        "bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "object",
          "required": [
            "inputs",
            "outputs"
          ],
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "outputs": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "intention",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "intention": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "entry",
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "string",
          "pattern": "^P"
        }
      }
    }
  }
}
