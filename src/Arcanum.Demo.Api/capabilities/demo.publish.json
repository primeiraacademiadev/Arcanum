{
  "name": "demo.publish",
  "displayName": "Publicação de auditoria — demonstração",
  "description": "Valida, enriquece e termina com dados da mesma execução.",
  "version": 1,
  "contract": {
    "inputs": {
      "request": {
        "type": "Arcanum.Demo.Api.DemoInput",
        "source": "$"
      }
    },
    "responses": {
      "@complete": {
        "name": "final",
        "type": "Arcanum.Demo.Api.CompletedData"
      },
      "@stop": {
        "name": "validated",
        "type": "Arcanum.Demo.Api.ValidationData"
      }
    }
  },
  "processes": {
    "Arcanum.Demo.Api.ValidateProcess": {
      "displayName": "Validar entrada",
      "description": "Valida os campos obrigatórios."
    },
    "Arcanum.Demo.Api.EnrichProcess": {
      "displayName": "Enriquecer dados",
      "description": "Normaliza o texto e utiliza recurso scoped."
    },
    "Arcanum.Demo.Api.FinishProcess": {
      "displayName": "Concluir",
      "description": "Verifica partilha de recurso por todos os passos."
    }
  },
  "graph": {
    "entry": "validate",
    "nodes": {
      "validate": {
        "process": "Arcanum.Demo.Api.ValidateProcess"
      },
      "enrich": {
        "process": "Arcanum.Demo.Api.EnrichProcess"
      },
      "finish": {
        "process": "Arcanum.Demo.Api.FinishProcess"
      }
    },
    "edges": [
      {
        "from": "validate",
        "intention": "valid",
        "to": "enrich"
      },
      {
        "from": "validate",
        "intention": "invalid",
        "to": "@stop"
      },
      {
        "from": "enrich",
        "intention": "enriched",
        "to": "finish"
      },
      {
        "from": "finish",
        "intention": "finished",
        "to": "@complete"
      }
    ]
  }
}
